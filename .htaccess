# URLs netes: /gasoil-agricola serveix gasoil-agricola.dc.html
Options -MultiViews

# Pàgines, components i script: el navegador ha de comprovar sempre si hi ha
# una versió nova (si no, capçalera i peu antics es barregen amb pàgines noves)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # La web de proves no s'ha d'indexar (còpia del domini real)
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} =~ /mialias\.net$/"
</IfModule>

# robots.txt, llms.txt i sitemap.xml en UTF-8 (accents)
AddCharset UTF-8 .txt .xml
RewriteEngine On

# --- Domini canònic: https://prosetel95.com (sense www) ---
# Només actua amb el domini real; la web de proves (mialias.net) no es toca.

RewriteCond %{HTTP_HOST} ^www\.prosetel95\.com$ [NC]
RewriteRule ^ https://prosetel95.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^prosetel95\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://prosetel95.com%{REQUEST_URI} [R=301,L]

# --- URLs de l'antiga web de Wix ---

RewriteRule ^gasoila/?$ /gasoil-automocio [R=301,L]
RewriteRule ^gasoilb/?$ /gasoil-agricola [R=301,L]
RewriteRule ^gasoilc/?$ /gasoil-calefaccio [R=301,L]
RewriteRule ^solsona/?$ /gasoil-solsona [R=301,L]
RewriteRule ^lleida/?$ /gasoil-lleida [R=301,L]
RewriteRule ^manresa/?$ /gasoil-manresa [R=301,L]
RewriteRule ^copia-de-sant-salvador-de-guardiola/?$ /gasoil-bergueda [R=301,L]
RewriteRule ^copia-de-gasoil-a/?$ /avis-legal [R=301,L]
RewriteRule ^promocions/?$ / [R=301,L]

# --- Redireccions 301 de les URLs antigues (només peticions del navegador) ---

# Portada amb nom de fitxer -> /
RewriteCond %{THE_REQUEST} \s/+(Prosetel-95(\s|%20)Home\.dc\.html|index\.html|home\.html)[\s?] [NC]
RewriteRule ^ / [R=301,L]

# pagina.dc.html -> /pagina (Header i Footer són components i es carreguen tal qual)
RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9-]+)\.dc\.html[\s?]
RewriteCond %1 !^(Header|Footer)$
RewriteRule ^ /%1 [R=301,L]

# /pagina/ -> /pagina
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/$ /$1 [R=301,L]

# --- Reescriptures internes ---

RewriteRule ^$ "Prosetel-95 Home.dc.html" [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.dc.html -f
RewriteRule ^([A-Za-z0-9-]+)$ $1.dc.html [L]
